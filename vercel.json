{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "tanstack-start",
      "installCommand": "cd ../.. && bun install",
      "buildCommand": "cd ../.. && bunx turbo run build --filter=web"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
