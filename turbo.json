{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": ["DATABASE_URL", "GEMINI_API_KEY", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "DEALS_LLM_MODEL", "DEALS_HIDE_SCORE", "DEALS_EXTRACT_PER_HOUR", "DEALS_SUBMIT_PER_DAY", "DEALS_EXTRACT_DAILY_BUDGET"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "GEMINI_API_KEY", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "DEALS_LLM_MODEL", "DEALS_HIDE_SCORE", "DEALS_EXTRACT_PER_HOUR", "DEALS_SUBMIT_PER_DAY", "DEALS_EXTRACT_DAILY_BUDGET"]
    }
  },
  "globalEnv": ["CI", "NODE_ENV", "VERCEL", "VERCEL_ENV", "VERCEL_URL"]
}
